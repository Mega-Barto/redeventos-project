{
  "name": "redeventos",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "postinstall": "nuxt prepare",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed:local": "bash scripts/db-seed-local.sh",
    "db:types": "supabase gen types typescript --local > shared/types/database.types.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.137",
    "@nuxt/ui": "4.11.2",
    "@nuxtjs/supabase": "2.0.10",
    "nuxt": "^4.5.2",
    "resend": "^6.31.0",
    "tailwindcss": "4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "typescript": "6",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11",
    "wrangler": "4.143.1"
  }
}
