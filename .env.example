# Valores de `supabase status` con Supabase local levantado (`bun run db:start`).
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_SUPABASE_SECRET_KEY=

# Correo transaccional. Si falta la clave, la app no envía correos.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM=Redeventos <onboarding@resend.dev>
