{
  "name": "Redeventos",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "remoteUser": "node",
  "containerEnv": {
    "TZ": "America/Bogota"
  },
  "mounts": [
    "source=redeventos-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=redeventos-nuxt,target=${containerWorkspaceFolder}/.nuxt,type=volume",
    "source=redeventos-bun-cache,target=/home/node/.bun/install/cache,type=volume"
  ],
  "forwardPorts": [3000, 8787, 8976],
  "portsAttributes": {
    "3000": { "label": "Nuxt dev", "onAutoForward": "notify" },
    "8787": { "label": "Wrangler dev", "onAutoForward": "notify" },
    "8976": { "label": "Wrangler login", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer",
        "ms-azuretools.vscode-docker",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        },
        "[vue]": { "editor.defaultFormatter": "biomejs.biome" },
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash",
        "vitest.enable": true,
        "vitest.commandLine": "bun run test"
      }
    }
  }
}
