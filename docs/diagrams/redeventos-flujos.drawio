        <mxCell id="p4e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#666666;" edge="1" parent="1" source="p4c" target="p4dec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#b85450;fontSize=11;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4dec" target="p4no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4e7" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#82b366;fontSize=11;fontColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4dec" target="p4d">
