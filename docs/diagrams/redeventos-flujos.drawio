  <diagram id="flujo-piloto" name="Flujo del piloto">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1title" value="&lt;b&gt;REDEVENTOS — FLUJO DEL PILOTO&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="p1sub" value="La plataforma registra la necesidad, la propuesta y el compromiso. Las personas cierran el match solas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="700" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p1leg" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; Paso del organizador&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; Sponsor o plataforma&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; Asistente&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; Decisión&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; Esa vía termina&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; Evento facilitado" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
