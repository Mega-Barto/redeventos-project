        <mxCell id="p5lane1" value="Venue sponsor" style="swimlane;startSize=36;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;html=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="500" height="700" as="geometry"/>
