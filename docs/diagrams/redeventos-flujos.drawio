        <mxCell id="p5title" value="&lt;b&gt;VENUE Y ALIADO LOCAL&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="p5sub" value="Dos fichas distintas. Las dos terminan en la misma propuesta." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="640" height="22" as="geometry"/>
