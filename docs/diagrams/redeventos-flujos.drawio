        </mxCell>
        <mxCell id="p1note" value="Fuera de este flujo: pagos, chat, RSVP propio, sello descargable. El moderador no aprueba publicaciones ni matches." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
