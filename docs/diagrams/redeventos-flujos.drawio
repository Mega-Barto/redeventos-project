        <mxCell id="p1g" value="&lt;b&gt;Asistente, sin cuenta&lt;/b&gt;&lt;br&gt;Se inscribe en el enlace externo&lt;br&gt;Redeventos no guarda la lista" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
