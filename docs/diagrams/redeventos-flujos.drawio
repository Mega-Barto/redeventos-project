        <mxCell id="p5v1" value="Publica el espacio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p5lane1">
          <mxGeometry x="50" y="52" width="400" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="p5v2" value="Ficha estática&lt;br&gt;Nombre, zona, capacidad, equipamiento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p5lane1">
          <mxGeometry x="50" y="124" width="400" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="p5v3" value="Modo de apoyo&lt;br&gt;Apoya gratis, depende del evento, o solo alquila&lt;br&gt;Sin precio en el piloto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p5lane1">
          <mxGeometry x="50" y="204" width="400" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="p5v4" value="Ve necesidades de espacio&lt;br&gt;La capacidad tiene que alcanzar a los asistentes esperados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p5lane1">
          <mxGeometry x="50" y="296" width="400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p5v5" value="El modo de apoyo se muestra.&lt;br&gt;No descarta el espacio por sí solo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p5lane1">
          <mxGeometry x="50" y="380" width="400" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="p5v6" value="Calendario derivado&lt;br&gt;Solo días en negociación o ya comprometidos.&lt;br&gt;El resto se entiende libre. No hay grilla editable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="p5lane1">
          <mxGeometry x="50" y="460" width="400" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p5v7" value="Envía o recibe una propuesta&lt;br&gt;Sigue en la página Match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="p5lane1">
          <mxGeometry x="50" y="556" width="400" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="p5lane2" value="Local sponsor" style="swimlane;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;html=1;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="96" width="500" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="p5l1" value="Declara qué puede aportar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p5lane2">
          <mxGeometry x="50" y="52" width="400" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="p5l2" value="Tipos del piloto&lt;br&gt;Productos, alimentación, equipos,&lt;br&gt;servicios o difusión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p5lane2">
          <mxGeometry x="50" y="124" width="400" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="p5l3" value="Cantidad o descripción&lt;br&gt;«100 refrigerios», «una publicación»&lt;br&gt;Nunca un monto en pesos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p5lane2">
          <mxGeometry x="50" y="216" width="400" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="p5l4" value="Filtra oportunidades&lt;br&gt;Categoría, tipo de necesidad,&lt;br&gt;asistentes, ciudad, fecha o rango" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p5lane2">
          <mxGeometry x="50" y="308" width="400" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p5l5" value="Las sugerencias ordenan y filtran.&lt;br&gt;No aceptan nada por su cuenta. Sin IA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p5lane2">
          <mxGeometry x="50" y="404" width="400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p5l6" value="Ve la oportunidad sin WhatsApp&lt;br&gt;ni teléfono del organizador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p5lane2">
