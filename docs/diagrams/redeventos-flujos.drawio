        </mxCell>
        <mxCell id="p1s" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="140" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="p1a" value="Registro&lt;br&gt;Aviso de privacidad y&lt;br&gt;compromiso de registro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="280" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p1b" value="&lt;b&gt;Organizador&lt;/b&gt;&lt;br&gt;Publica el evento y sus necesidades&lt;br&gt;Estado: published" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="280" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p1c" value="&lt;b&gt;Venue o aliado local&lt;/b&gt;&lt;br&gt;Ve la oportunidad y filtra&lt;br&gt;con reglas fijas, sin IA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="280" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p1d" value="&lt;b&gt;Propuesta&lt;/b&gt;&lt;br&gt;La inicia cualquiera de los dos lados&lt;br&gt;Necesidad + cantidad + fecha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p1dec1" value="¿La otra parte acepta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1rej" value="&lt;b&gt;Propuesta rechazada&lt;/b&gt;&lt;br&gt;La necesidad sigue abierta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="460" y="649" width="210" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p1e" value="&lt;b&gt;Compromiso de match&lt;/b&gt;&lt;br&gt;Qué, cuánto y cuándo&lt;br&gt;Se revelan WhatsApp y teléfono" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p1dec2" value="¿Hay fecha concreta y lugar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="100" y="900" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1stay" value="&lt;b&gt;Sigue published&lt;/b&gt;&lt;br&gt;Solo lo ven los sponsors&lt;br&gt;Hasta cerrar fecha y lugar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="460" y="919" width="210" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p1f" value="&lt;b&gt;Ficha pública&lt;/b&gt;&lt;br&gt;Estado: public&lt;br&gt;/eventos/[slug]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="1050" width="280" height="72" as="geometry"/>
