  <diagram id="flujo-match" name="Match">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p4title" value="&lt;b&gt;PROPUESTA Y MATCH&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="p4sub" value="Bidireccional. No hay operador ni chat. Cada necesidad tiene su propio match." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="760" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="p4s1" value="Organizador" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="96" width="160" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="p4s2" value="Venue o local sponsor" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="96" width="200" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="p4a" value="Elige un sponsor&lt;br&gt;y una necesidad propia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="p4b" value="Elige una necesidad&lt;br&gt;ya publicada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="180" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="p4c" value="&lt;b&gt;Propuesta pendiente&lt;/b&gt;&lt;br&gt;Necesidad + cantidad o descripción + fecha&lt;br&gt;Sin montos en pesos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="300" width="360" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="p4dec" value="¿La otra parte acepta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="416" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4no" value="&lt;b&gt;Rechazada&lt;/b&gt;&lt;br&gt;No hay compromiso&lt;br&gt;No se revelan contactos directos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="430" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4d" value="&lt;b&gt;Aceptada&lt;/b&gt;&lt;br&gt;Nace el match y el compromiso:&lt;br&gt;qué, cuánto y cuándo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="566" width="300" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="p4e" value="&lt;b&gt;Contactos directos&lt;/b&gt;&lt;br&gt;WhatsApp y teléfono de las dos partes&lt;br&gt;Correo, Instagram y web ya eran públicos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="680" width="340" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="p4f" value="Coordinan fuera de Redeventos&lt;br&gt;No hay chat en el producto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="792" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p4dec2" value="¿Queda resto por cubrir?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="888" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p4part" value="&lt;b&gt;Necesidad partial&lt;/b&gt;&lt;br&gt;Sigue abierta por el resto&lt;br&gt;Puede recibir otra propuesta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1028" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4cov" value="&lt;b&gt;Necesidad covered&lt;/b&gt;&lt;br&gt;Esa necesidad queda cubierta&lt;br&gt;El evento sigue si hay otras abiertas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1028" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4note" value="Ejemplo: 100 refrigerios pedidos y 40 aceptados dejan la necesidad en partial. Un aporte como «el auditorio» se anota como descripción. El evento no se cierra solo porque una necesidad quede cubierta." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1148" width="800" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="p4e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#666666;" edge="1" parent="1" source="p4s1" target="p4a">
