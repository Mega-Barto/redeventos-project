<mxfile host="app.diagrams.net" modified="2026-09-29T09:00:00.000Z" agent="Cursor" version="22.1.0">
  <diagram id="bmc-redeventos-futuro" name="Modelo Canvas futuro">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;REDEVENTOS — MODELO CANVAS (FUTURO / POST-PILOTO)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Propuesta inicial · entrar sin costo · cobrar cuando hay transacción · Pereira y otras ciudades intermedias&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1a1a1a;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="partners" value="&lt;b&gt;Socios clave&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Quién te puede ayudar?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Organizadores y comunidades locales&lt;br&gt;• Venues y espacios culturales&lt;br&gt;• Negocios locales (especie y dinero)&lt;br&gt;• Proveedores de producción (foto, video, sonido, catering)&lt;br&gt;• Pasarela de pagos (cuando hay efectivo)&lt;br&gt;• Supabase · Cloudflare · Resend&lt;br&gt;• Moderación y aliados en nuevas ciudades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="220" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="activities" value="&lt;b&gt;Actividades clave&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Qué harás para cumplir la propuesta de valor?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Matches de necesidades ↔ aportes (especie y dinero)&lt;br&gt;• Newsletter de oportunidades a sponsors&lt;br&gt;• Calendario y precio de venues que alquilan&lt;br&gt;• Comisión sobre transacción (patrocinio, alquiler, servicios)&lt;br&gt;• Evidencia, sello de la red y casos de éxito" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="72" width="220" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="resources" value="&lt;b&gt;Recursos clave&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Qué recursos necesitas para la propuesta de valor?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Plataforma web (Nuxt + Workers + Supabase)&lt;br&gt;• Red local de organizadores, venues y aliados&lt;br&gt;• Marca, sello y reglas de comunidad&lt;br&gt;• Pasarela y contratos (cuando hay dinero)&lt;br&gt;• Operación: soporte, moderación, adquisición" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="257" width="220" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="value" value="&lt;b&gt;Propuesta de valor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Qué haces diferente de la competencia?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Infraestructura para crear, apoyar, promocionar y descubrir eventos locales&lt;br&gt;• Sigue siendo &amp;quot;cómo producir el evento&amp;quot;, no una agenda&lt;br&gt;• En especie: match gratis, sin operador&lt;br&gt;• Con dinero: la plataforma registra la transacción y cobra un take rate&lt;br&gt;• Visibilidad para sponsors (newsletter y sello)&lt;br&gt;• De Pereira/Dosquebradas a otras ciudades intermedias" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="72" width="240" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="relationships" value="&lt;b&gt;Relación con clientes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Cómo interactúas con los clientes?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Self-service en el core (publicar, proponer, aceptar)&lt;br&gt;• Entrar siempre sin costo&lt;br&gt;• Relación transaccional solo si hay dinero&lt;br&gt;• Newsletter y visibilidad para sponsors&lt;br&gt;• Moderación y sello como gobernanza de confianza" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="72" width="220" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="channels" value="&lt;b&gt;Canales&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Cómo llegas a los clientes?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Web app (SSR, SEO) y fichas públicas&lt;br&gt;• Newsletter hacia sponsors&lt;br&gt;• Calendario de venues con precio (los que alquilan)&lt;br&gt;• Sello de la red en el local y casos de éxito&lt;br&gt;• Ecosistema local y referidos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="257" width="220" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="segments" value="&lt;b&gt;Segmento de clientes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿A quién ayudarás?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Organizadores (gratuitos / bajo costo; luego también con presupuesto)&lt;br&gt;• Venue sponsors (apoyan gratis o alquilan)&lt;br&gt;• Local sponsors (especie o efectivo)&lt;br&gt;• Proveedores de producción (cuarto lado)&lt;br&gt;• Asistentes (descubren ficha pública)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Quien hace match en especie no es cliente de pago&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="72" width="220" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="costs" value="&lt;b&gt;Estructura de costos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Cuánto te costará?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Plataforma (bajo, escala con uso):&lt;/b&gt; Cloudflare, Supabase, Resend, analítica, dominio, CI&lt;br&gt;• &lt;b&gt;Operación (el costo grande):&lt;/b&gt; desarrollo, moderación, soporte y adquisición local&lt;br&gt;• &lt;b&gt;Transacción (solo si hay dinero):&lt;/b&gt; pasarela, conciliación, impuestos y facturación&lt;br&gt;• &lt;b&gt;Expansión:&lt;/b&gt; onboarding humano por ciudad, no solo copiar el software&lt;br&gt;• Principio: la nube no quiebra el modelo; el tiempo de red y confianza sí hay que cubrilo con take rate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="444" width="580" height="216" as="geometry"/>
        </mxCell>
        <mxCell id="revenue" value="&lt;b&gt;Fuente de ingresos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Cuántos ingresos tendrás?&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Núcleo — take rate:&lt;/b&gt; comisión sobre patrocinio en efectivo, alquiler de venue y servicios de producción&lt;br&gt;• &lt;b&gt;Red — secundario:&lt;/b&gt; newsletter con slot destacado y, más tarde, suscripción premium de herramientas&lt;br&gt;• &lt;b&gt;Réplica:&lt;/b&gt; otras ciudades con el mismo modelo, no una línea nueva&lt;br&gt;• En especie (espacio, refrigerios, difusión) sigue &lt;b&gt;sin cobro&lt;/b&gt;&lt;br&gt;• Orden: newsletter → dinero → alquiler → servicios → premium → ciudades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a3d2e;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="444" width="570" height="216" as="geometry"/>
        </mxCell>
        <mxCell id="footnote" value="Hipótesis alineada con idea.md §20. No forma parte del piloto. Detalle de costos e ingresos en la segunda hoja." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="668" width="1160" height="28" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="costos-ingresos-futuro" name="Costos e ingresos">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="&lt;b&gt;REDEVENTOS — PROPUESTA INICIAL DE COSTOS E INGRESOS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Post-piloto · idea.md §20 · no está en el producto actual&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#1a1a1a;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1220" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="p2-principle" value="&lt;b&gt;Principio de cobro:&lt;/b&gt; entrar sin costo. Cobrar cuando exista una transacción. El match en especie (espacio, productos, alimentación, equipos, servicios donados, difusión) sigue gratis." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a3d2e;strokeColor=#ffffff;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1220" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="p2-cost-plat" value="&lt;b&gt;Costos de plataforma&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Bajos y variables con uso&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Cloudflare Workers, DNS, CDN&lt;br&gt;• Supabase (DB, Auth, Storage)&lt;br&gt;• Resend (transaccional + volumen de newsletter)&lt;br&gt;• PostHog, Sentry, dominio, GitHub/CI&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Hipótesis: decenas de USD/mes al salir del free; cientos USD/mes si hay varias ciudades y correo masivo. No es el costo que define el negocio.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="400" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="p2-cost-ops" value="&lt;b&gt;Costos de operación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;El costo dominante&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Desarrollo y mantenimiento&lt;br&gt;• Moderación (evidencias, reportes, sello)&lt;br&gt;• Adquisición: organizadores primero, luego venues y locales&lt;br&gt;• Soporte de matches y, después, de pagos&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;La red no se construye sola. El take rate tiene que cubrir tiempo humano, no solo servidores.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="140" width="400" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="p2-cost-tx" value="&lt;b&gt;Costos de transacción&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Solo cuando hay dinero&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Comisión de pasarela (CO: ~2,5–4 % + IVA)&lt;br&gt;• Conciliación, disputas, reembolsos&lt;br&gt;• Persona jurídica, contratos, facturación&lt;br&gt;• Cumplimiento (habeas data, términos)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;No se asumen en el piloto. Entran juntos con aportes en dinero (paso 2).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="140" width="400" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="p2-rev-core" value="&lt;b&gt;Ingresos núcleo — take rate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Cobrar cuando hay transacción&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;2. Patrocinio en efectivo:&lt;/b&gt; comisión 8–12 % sobre el aporte que pase por la plataforma. Paga el local sponsor / marca.&lt;br&gt;• &lt;b&gt;3. Alquiler de venue:&lt;/b&gt; comisión 5–10 % sobre la reserva cuando el espacio publica precio y calendario. Paga quien alquila (organizador).&lt;br&gt;• &lt;b&gt;4. Servicios de producción:&lt;/b&gt; comisión 10–15 % sobre foto, video, sonido, catering. Paga el organizador; el proveedor entra como cuarto lado.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Porcentajes: hipótesis de partida, no tarifas publicadas. Deben dejar margen sobre la pasarela.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a3d2e;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="406" width="610" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="p2-rev-net" value="&lt;b&gt;Ingresos de red — secundarios&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;No sustituyen el take rate&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;1. Newsletter a sponsors:&lt;/b&gt; primero es canal (oportunidades). Después, 1–2 slots destacados por edición a tarifa fija.&lt;br&gt;• &lt;b&gt;5. Suscripción premium:&lt;/b&gt; cuota mensual para organizadores o venues que pidan herramientas extra (stats, multi-evento, calendario avanzado). Entra tarde, no antes de haber transacción.&lt;br&gt;• &lt;b&gt;6. Otras ciudades:&lt;/b&gt; réplica del mismo modelo; no es una línea de ingreso distinta.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Mix hipotético a madurez: ~75 % take rate · ~15 % premium · ~10 % visibilidad.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a3d2e;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="406" width="600" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="p2-free" value="&lt;b&gt;Sigue gratis (a propósito)&lt;/b&gt;&lt;br&gt;Publicar evento · publicar espacio o aporte en especie · match y compromiso · ficha pública · sello En la red · descubrimiento del asistente. El Aliado activo se gana con evidencia, no se compra." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="702" width="610" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p2-order" value="&lt;b&gt;Orden de apertura (no negociar el orden)&lt;/b&gt;&lt;br&gt;1 Newsletter (canal) → 2 dinero + comisión → 3 precio/calendario de venues → 4 servicios con comisión → 5 premium → 6 otras ciudades.&lt;br&gt;No abrir 2 sin eventos facilitados de verdad. No abrir 5 como SaaS antes de haber take rate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2b2b2b;strokeColor=#ffffff;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="702" width="600" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p2-foot" value="Costos de expansión (onboarding por ciudad) se cubren con el take rate de esa ciudad, no con la nube. Ver modelo-canvas-futuro.md" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="822" width="1220" height="28" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
